# This is a trusted Bash environment file, sourced inside 26fly-runtime every time
# a process starts. It is bind-mounted read-only, so these values can be changed
# without rebuilding or recreating the pet container.

# ROS 2 and resource limits
ROS_DOMAIN_ID=0
BUILD_JOBS=2
OMP_NUM_THREADS=2
COLCON_PACKAGES="px4_msgs detect control"
PX4_MSGS_EXPECTED_VERSION=2.0.1
PX4_MSGS_EXPECTED_COMMIT=86d8239e962f6939e05c3737784f60c02fa884db

# RealSense and detector. Each TensorRT engine is tracked in its owning package
# inside the Jetson source repository.
REALSENSE_ALIGN_DEPTH=true
REALSENSE_CAMERA_HINT=RealSense
DETECT_MODEL=/workspace/src/detect/models/26n_0807_bright_needle.engine
DETECT_CONFIDENCE=0.4
DETECT_COLOR_TOPIC=/camera/camera/color/image_raw
DETECT_DEPTH_TOPIC=/camera/camera/aligned_depth_to_color/image_raw
DETECT_CAMERA_INFO_TOPIC=/camera/camera/color/camera_info
DETECT_RECORD_VIDEO=false
DETECT_PUBLISH_LEGACY_TARGET=false

# Live control application. Keep the permission switch disabled here: the host
# operator must explicitly set ALLOW_FLIGHT_CONTROL=YES for each invocation.
ALLOW_FLIGHT_CONTROL=NO
CONTROL_MODEL=/workspace/src/fly/models/26n_0807_bright_needle.engine
CONTROL_CAMERA_HINT=imx577
WIDE_CAMERA_DEVICE=/dev/v4l/by-id/usb-LRCP_imx577_LRCP_imx577_01.00.00-video-index0
CONTROL_RECORD_VIDEO=false
CONTROL_REQUIRE_PX4_TOPICS=true
CONTROL_REQUIRE_VISION_TOPICS=true

# PX4 uXRCE-DDS. This assumes the 1a86 TTL adapter is connected to the FCU UART
# configured for uXRCE-DDS. Do not fall back to enumeration-dependent ttyACM names.
XRCE_TRANSPORT=serial
XRCE_SERIAL_DEVICE=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5A98038797-if00
XRCE_SERIAL_CANDIDATES=""
XRCE_BAUD=921600
XRCE_UDP_PORT=8888
XRCE_VERBOSE=

# MAVLink input uses the CUAV USB connection and must remain a DIFFERENT FCU
# port/link from the XRCE serial input.
# The default exposes TCP :5760 and routes no UDP traffic off-board. Add one or
# more targets such as "192.168.1.10:14550" only on a trusted flight network.
MAVLINK_TRANSPORT=serial
MAVLINK_SERIAL_DEVICE=/dev/serial/by-id/usb-CUAV_PX4_CUAV_X7Pro_0-if00
MAVLINK_SERIAL_CANDIDATES=""
MAVLINK_BAUD=921600
MAVLINK_UDP_LISTEN=0.0.0.0:24550
MAVLINK_UDP_ENDPOINTS=""
MAVLINK_ENABLE_FLIGHT_LOG=false

# A missing/re-enumerated device makes the wrapper wait briefly; systemd then
# restarts the service and performs discovery again against the live host /dev.
DEVICE_DISCOVERY_TIMEOUT=15
