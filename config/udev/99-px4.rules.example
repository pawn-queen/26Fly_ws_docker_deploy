# HOST-ONLY example. Inspect each physical serial adapter first:
#   udevadm info --attribute-walk --name=/dev/ttyACM0
# Replace both placeholders, install this file under /etc/udev/rules.d on the
# Jetson host, reload udev, and reconnect the devices. Never install it only in
# the container and never use chmod -R 777 /dev.

# XRCE and MAVLink cannot open the same serial interface. In a real installation
# these normally represent two independent FCU links/adapters.
SUBSYSTEM=="tty", ATTRS{serial}=="REPLACE_WITH_XRCE_LINK_SERIAL", SYMLINK+="px4_xrce", GROUP="dialout", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{serial}=="REPLACE_WITH_MAVLINK_LINK_SERIAL", SYMLINK+="px4_mavlink", GROUP="dialout", MODE="0660", TAG+="uaccess"

# Then set in config/runtime.env:
# XRCE_SERIAL_DEVICE=/dev/px4_xrce
# MAVLINK_SERIAL_DEVICE=/dev/px4_mavlink
