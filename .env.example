# Image and the one long-lived pet container.
BASE_IMAGE=ultralytics/ultralytics:8.4.138-jetson-jetpack6
ULTRALYTICS_VERSION=8.4.138
XRCE_AGENT_VERSION=v2.4.2
MAVLINK_ROUTER_VERSION=v4
APP_IMAGE=26fly-jetson:jp6-humble-ultralytics-8.4.138
CONTAINER_NAME=26fly-runtime

# Literal host paths. Do not escape underscores. init-env.sh rewrites all three
# paths for the directory in which this deployment repository is installed.
HOST_WS_SRC=/home/queen/uav/26Season_Fly_ws_jetson/src
HOST_MODEL_DIR=/home/queen/uav/26Fly_ws_docker_deploy/models
HOST_CONFIG_DIR=/home/queen/uav/26Fly_ws_docker_deploy/config

# Persistent ROS workspace volumes. Change this when changing an ABI or major branch.
VOLUME_PREFIX=26fly-jp6-humble-px4-1.17

# Orin Nano 8 GB: keep image/workspace builds conservative.
BUILD_JOBS=2

# External ROS interface source. Keep this tag aligned with the FCU firmware.
PX4_MSGS_REPOSITORY=https://github.com/PX4/px4_msgs.git
PX4_MSGS_REF=v1.17.0
