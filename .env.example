COMPOSE_PROJECT_NAME=26fly

# Fixed application/runtime versions. For bit-for-bit rebuilds, replace the base tag with a digest.
BASE_IMAGE=ultralytics/ultralytics:8.4.138-jetson-jetpack6
ULTRALYTICS_VERSION=8.4.138
APP_IMAGE=26fly-jetson:jp6-humble-ultralytics-8.4.138
XRCE_IMAGE=26fly-xrce-agent:2.4.2
XRCE_AGENT_VERSION=v2.4.2
FAST_DDS_GIT_TAG=v2.12.2

# Host paths are literal paths; do not add backslashes before underscores.
HOST_WS_SRC=/home/queen/uav/26Season_Fly_ws_archive/src
HOST_MODEL_DIR=/home/queen/uav/26Fly_ws_docker_deploy/models

# Run scripts/init-env.sh --force on the target Jetson to detect these values.
HOST_UID=1000
HOST_GID=1000
VIDEO_GID=44
DIALOUT_GID=20
RENDER_GID=110
PLUGDEV_GID=46

# Keep this equal to PX4 UXRCE_DDS_DOM_ID. PX4 defaults to domain 0.
ROS_DOMAIN_ID=0
BUILD_JOBS=2
OMP_NUM_THREADS=2
VOLUME_PREFIX=26fly-jp6-humble

# Existing .pt models work as a first baseline. Prefer target-built .engine files for flight.
DETECT_MODEL=/workspace/src/detect/models/26n_0807_bright_needle.pt
CONTROL_MODEL=/workspace/src/fly/models/26n_0807_bright_needle.pt
DETECT_CONFIDENCE=0.4
DETECT_COLOR_TOPIC=/camera/camera/color/image_raw
DETECT_DEPTH_TOPIC=/camera/camera/aligned_depth_to_color/image_raw
DETECT_CAMERA_INFO_TOPIC=/camera/camera/color/camera_info
DETECT_RECORD_VIDEO=false
DETECT_PUBLISH_LEGACY_TARGET=false
CONTROL_CAMERA_HINT=imx577
CONTROL_RECORD_VIDEO=false
CONTROL_REQUIRE_PX4_TOPICS=true

# Map only the required devices. Current control code needs the raw /dev/videoN path;
# prefer a stable udev symlink only for PX4 unless camera selection is changed in Python.
WIDE_CAMERA_DEVICE=/dev/video0
PX4_SERIAL_DEVICE=/dev/ttyACM1
PX4_BAUD=921600
PX4_UDP_PORT=8888

# Safety interlock: leave NO until source blockers and bench checks are resolved.
ALLOW_FLIGHT_CONTROL=NO

# px4_ros_com is not imported by the current real-flight nodes, so it is not built by default.
COLCON_PACKAGES="px4_msgs detect control"
