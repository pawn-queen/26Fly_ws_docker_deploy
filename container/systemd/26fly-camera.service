[Unit]
Description=26Fly RealSense camera
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=/etc/26fly/runtime.env
Requires=systemd-journald.service systemd-journal-flush.service
After=systemd-journald.service systemd-journal-flush.service

[Service]
Type=exec
WorkingDirectory=/workspace
ExecStart=/usr/local/bin/run-camera
Restart=no
KillMode=control-group
KillSignal=SIGINT
SendSIGKILL=yes
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=26fly.target
