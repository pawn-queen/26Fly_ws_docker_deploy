[Unit]
Description=26Fly RealSense camera
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=/etc/26fly/runtime.env

[Service]
Type=exec
WorkingDirectory=/workspace
ExecStart=/usr/local/bin/run-camera
Restart=no
KillMode=control-group
KillSignal=SIGINT
SendSIGKILL=yes
TimeoutStopSec=15
StandardOutput=inherit
StandardError=inherit

[Install]
WantedBy=26fly.target
